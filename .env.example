DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/hcm_dev
JWT_SECRET=
DOC_ENCRYPTION_KEY=
DOC_HMAC_PEPPER=
STORAGE_LOCAL_PATH=./storage
OCR_ENABLED=false
PORT=3000
# Solo para probar desde el celular u otro equipo de la red: la IP de tu PC.
# Web y archivos usan esta URL para llegar al API (docker compose la lee de este archivo).
# API_PUBLIC_URL=http://192.168.1.4:3000

# ---- Solo con PROVEEDOR=aws (los inyecta ECS; ver AWS-hcm/infra/envs) ----
# PROVEEDOR=local            # "aws" usa S3, SQS, SNS y DynamoDB en lugar de los adaptadores locales
# DB_HOST=                   # alternativa a DATABASE_URL: la URL se arma con TLS (sslmode=require)
# DB_PORT=5432
# DB_NAME=hcm
# DB_USER=
# DB_PASSWORD=
# BUCKET_EVIDENCIAS=
# TABLA_PERFIL_PUBLICO=
# ARN_TEMA_RECORDATORIOS=
# URL_COLA_NORMALIZACION=
# URL_COLA_PROYECCION=

# Solo pruebas y demostraciones locales: el código de verificación del correo siempre vale esto.
# La API no arranca con esto si PROVEEDOR=aws.
# CODIGO_VERIFICACION_FIJO=123456

# Tope de solicitudes por minuto y por IP para el inicio de sesión y el alta de cuentas (por defecto 30).
# LIMITE_AUTENTICACION_POR_MINUTO=30
